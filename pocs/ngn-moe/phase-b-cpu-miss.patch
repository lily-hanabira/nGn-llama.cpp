+            c.w_down    = ml.ffn_down_exps;
+            c.b_gate_up = host_bias(ml.ffn_gate_up_exps_b);
+            c.b_gate    = host_bias(ml.ffn_gate_exps_b);
+            c.b_up      = host_bias(ml.ffn_up_exps_b);
